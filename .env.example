# Copy to .env and replace values. Never commit real credentials.
# Use distinct, long alphanumeric database passwords so the connection URLs
# do not require URL escaping. Both password occurrences must match.

# Production on the NAS
PUBLIC_BASE_URL=https://events.example.com
APP_IMAGE=ghcr.io/your-account/your-app:prod
GOOGLE_CLIENT_ID=your-google-web-client-id
GOOGLE_CLIENT_SECRET=your-google-web-client-secret
POSTGRES_PASSWORD=replace-with-production-admin-password
APP_DB_PASSWORD=replace-with-production-app-password
DATABASE_URL=postgresql://quiz_app:replace-with-production-app-password@postgres:5432/quiz_prod?sslmode=disable
DATABASE_MAX_CONNECTIONS=10
TUNNEL_TOKEN=your-cloudflare-tunnel-token

# Local and NAS development (separate database and credentials)
DEV_ADMIN_PASSWORD=replace-with-development-login-password
DEV_IMAGE=ghcr.io/your-account/your-app:dev
DEV_PUBLIC_BASE_URL=http://nas-dev.example.local:8082
DEV_POSTGRES_PASSWORD=replace-with-development-admin-password
DEV_APP_DB_PASSWORD=replace-with-development-app-password
DEV_DATABASE_URL=postgresql://quiz_app:replace-with-development-app-password@postgres:5432/quiz_dev?sslmode=disable

# Optional immediate deployment controller
CONTROL_IMAGE=ghcr.io/your-account/your-app:control
CONTROL_API_TOKEN=generate-at-least-32-random-characters
PORTAINER_URL=https://nas-private-address:9443
PORTAINER_API_KEY=create-this-in-the-portainer-account-page
PORTAINER_INSECURE_SKIP_VERIFY=true
APP_IMAGE_REPOSITORY=ghcr.io/your-account/your-app
DEV_STACK_NAME=quiz-dev
DEV_ENDPOINT_ID=1
PROD_STACK_NAME=quiz-prod
PROD_ENDPOINT_ID=1
