# Copy this file to .env and fill in the values before deploying.
# Never commit .env to git!

# ── Production secrets ────────────────────────────────────────────
PUBLIC_BASE_URL=https://events.example.com
APP_IMAGE=ghcr.io/your-account/your-app:release-sha
GOOGLE_CLIENT_ID=your-google-web-client-id
GOOGLE_CLIENT_SECRET=your-google-web-client-secret
MONGO_DB_NAME=eventdb
MONGO_URI=mongodb://mongo:27017
TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# ── Local and NAS development ─────────────────────────────────────
DEV_ADMIN_PASSWORD=choose-a-development-password
DEV_IMAGE=ghcr.io/your-account/your-app:development-sha
DEV_PUBLIC_BASE_URL=http://nas-dev.example.local:8082
DEV_MONGO_URI=mongodb://mongo:27017
DEV_MONGO_DB_NAME=event_dev
